# Build-context exclusions. Everything here is either regenerated inside the
# image, host-specific, or irrelevant to `next build` — keeping the context
# small is what keeps `docker build` fast on Dokploy's builder.

# Dependencies (reinstalled from pnpm-lock.yaml inside the image)
node_modules
**/node_modules

# Build output (rebuilt in the build stage)
.next
**/.next
dist
**/dist
out
apps/web/out
# 73 MB of duckdb-wasm bundles, regenerated by apps/web `prebuild`
# (scripts/copy-duckdb.mjs). Never send them over the wire.
apps/web/public/duckdb

# VCS / CI
.git
.gitignore
.github
.gitattributes

# Tests and their artifacts — not part of the server build
apps/web/e2e
apps/web/test
apps/web/test-results
apps/web/playwright-report
**/test-results
**/playwright-report
**/*.test.ts
**/*.test.tsx
**/vitest.config.ts
spike

# Docs, design references and other local-only material
docs
*.md
.design-ref
.impeccable
**/.impeccable
scripts/seed-demo-data.mjs

# Local env + editor + OS noise (secrets must come from Dokploy, never the image)
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
**/.DS_Store
*.log
*.tsbuildinfo
**/*.tsbuildinfo
.turbo
.vercel

# Deploy files themselves (nothing in the build needs them)
docker-compose.yml
Dockerfile
.dockerignore
